# Copy to .env for local dev. NEVER commit real values (AGENTS.md: secrets live in env/Railway).
# Production values live in Railway config — this file is a local-dev convenience only.

# --- Core (config/settings/base.py) -----------------------------------------
DJANGO_SECRET_KEY=generate-a-real-one-for-prod
DJANGO_DEBUG=True
# Local Postgres via `docker compose up -d db`; falls back to sqlite when unset.
DATABASE_URL=postgres://dealwright:dealwright@localhost:5432/dealwright
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Google social login (Q13; optional) ------------------------------------
# Activates only when BOTH are set — the "Continue with Google" button and the
# /accounts/google/* endpoints appear automatically (config/settings/base.py).
# Setup: https://console.cloud.google.com/apis/credentials → Create OAuth client ID
#   · Application type: Web application
#   · Authorized redirect URI: http://localhost:8000/accounts/google/login/callback/
#     (prod: https://<your-domain>/accounts/google/login/callback/)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# --- Production only (config/settings/production.py; Railway config) --------
# Transactional email — required in prod: password reset / verification mails.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Dealwright <no-reply@dealwright.io>
# Set False only behind a trusted TLS-terminating proxy that strips the header.
# DJANGO_SECURE_SSL_REDIRECT=True
